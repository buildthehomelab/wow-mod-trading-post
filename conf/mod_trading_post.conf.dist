[worldserver]

########################################
# mod-trading-post
#
# Retail's Trading Post and Traveler's Log. The monthly themes, stock and activities are world SQL
# (tools/build_data.py); this file sets what they pay.
########################################

#
#    TradingPost.Enable
#        Description: Master switch. With 0 no activity counts and the proprietors say they are
#                     closed. Tender and purchases are kept.
#        Default:     1
#

TradingPost.Enable = 1

#
#    TradingPost.Cache.Tender
#        Description: Trader's Tender in the Collector's Cache, taken once a month per account at
#                     a proprietor.
#        Default:     500
#

TradingPost.Cache.Tender = 500

#
#    TradingPost.Log.Points
#        Description: Traveler's Log points that complete the month.
#        Default:     1000
#

TradingPost.Log.Points = 1000

#
#    TradingPost.Log.Tender
#        Description: Trader's Tender for completing the month's log, paid with its bonus reward.
#        Default:     500
#

TradingPost.Log.Tender = 500

#
#    TradingPost.Log.SaveSeconds
#        Description: How often activity progress is written. A crash loses at most this much
#                     progress. At least 5.
#        Default:     30
#

TradingPost.Log.SaveSeconds = 30

#
#    TradingPost.AccountWideSpells
#        Description: 1: a mount or companion bought goes to the whole account, on a server with
#                     mod-accountwide-mounts / mod-accountwide-pets tables. 0, or without those
#                     tables: it is mailed to the character that bought it.
#        Default:     1
#

TradingPost.AccountWideSpells = 1

#
#    TradingPost.CurrencyItem
#        Description: The item whose icon and tooltip stand for Tender in DragonUI's Currency tab.
#                     The world SQL renames this one, a test token nothing else uses, and drops its
#                     translated names. 0: no row.
#        Default:     37711
#

TradingPost.CurrencyItem = 37711

#
#    TradingPost.ProgressionGate
#        Description: 1: goods with a phase in mod_trading_post_stock stay locked until a character
#                     of the account reaches that mod-individual-progression phase. Without that
#                     module nothing is locked.
#        Default:     1
#

TradingPost.ProgressionGate = 1
